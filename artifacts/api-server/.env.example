# SYSmoAI API Server — Environment Variables
# Copy to .env and fill in values (never commit .env)

# Server port (required)
# PORT=3001

# PostgreSQL database URL (required)
# DATABASE_URL=postgresql://user:password@host:5432/sysmoai

# Clerk publishable key (required for auth)
# CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Clerk secret key (required for admin proxy)
# CLERK_SECRET_KEY=sk_test_xxx

# Admin email allowlist (comma-separated, default: hello@sysmoai.com)
# ADMIN_ALLOWLIST_EMAILS=hello@sysmoai.com

# CORS allowed origins (comma-separated)
# REPLIT_DOMAINS=sysmoai.com,admin.sysmoai.com

# Log level (trace|debug|info|warn|error|fatal, default: info)
# LOG_LEVEL=info

# Node environment
# NODE_ENV=development
