{
  "name": "SYSmoAI — Content Pack Auto-Publisher",
  "_about": "Hourly cron sweeps the queue for posts whose scheduledFor is in [now-30m, now+24h], pushes text-only channels into Buffer with provider-side scheduled_at so each row publishes at its own BDT slot, sends the newsletter via Resend within 1h of its slot, and (a) Buffer-schedules IG/TikTok with media when the operator has set assetUrl on the row, otherwise (b) posts a Slack manual-publish alert (also gated to within 1h of slot) so the operator can publish manually. X threads are split on '\\n---\\n', the 'Tweet N/M' header is stripped, and each tweet is sent as a real Buffer thread. Rows already pushed (postUrl set) are skipped on later sweeps. The lower bound on scheduledFor prevents stale queued rows from being re-sent. Required env: SYSMOAI_API_BASE, SYSMOAI_AUTOMATION_TOKEN, SYSMOAI_ADMIN_BASE, BUFFER_ACCESS_TOKEN, BUFFER_PROFILE_LINKEDIN, BUFFER_PROFILE_X, BUFFER_PROFILE_INSTAGRAM, BUFFER_PROFILE_TIKTOK, RESEND_API_KEY, NEWSLETTER_FROM, NEWSLETTER_AUDIENCE_ID, SLACK_FALLBACK_CHANNEL.",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] } },
      "id": "cron-hourly",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [180, 360]
    },
    {
      "parameters": {
        "url": "={{ $env.SYSMOAI_API_BASE }}/api/admin/scheduled-posts",
        "qs": {
          "status": "queued",
          "from": "={{ $now.minus({ minutes: 30 }).toISO() }}",
          "to": "={{ $now.plus({ hours: 24 }).toISO() }}",
          "pageSize": 50
        },
        "options": {
          "headers": {
            "parameters": {
              "Authorization": "=Bearer {{ $env.SYSMOAI_AUTOMATION_TOKEN }}"
            }
          }
        }
      },
      "id": "fetch-due",
      "name": "Fetch posts in [now-30m, now+24h]",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [400, 360],
      "_about": "Lower bound (now-30m) prevents stale queued rows (e.g. a slot we missed days ago) from being auto-published or auto-alerted. Upper bound (now+24h) is what feeds Buffer's provider-side scheduling queue."
    },
    {
      "parameters": { "fieldToSplitOut": "items", "options": {} },
      "id": "split",
      "name": "Split items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [600, 360]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.postUrl || '' }}", "operation": "isEmpty" }
          ]
        }
      },
      "id": "skip-if-already-queued",
      "name": "Skip if already queued",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [780, 360]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "operation": "equal", "value1": "={{ $json.platform }}", "value2": "linkedin", "outputIndex": 0 },
            { "operation": "equal", "value1": "={{ $json.platform }}", "value2": "x_standalone", "outputIndex": 1 },
            { "operation": "equal", "value1": "={{ $json.platform }}", "value2": "x_thread", "outputIndex": 2 },
            { "operation": "equal", "value1": "={{ $json.platform }}", "value2": "newsletter", "outputIndex": 3 },
            { "operation": "equal", "value1": "={{ $json.platform }}", "value2": "instagram_feed", "outputIndex": 4 },
            { "operation": "equal", "value1": "={{ $json.platform }}", "value2": "instagram_story", "outputIndex": 4 },
            { "operation": "equal", "value1": "={{ $json.platform }}", "value2": "tiktok_reel", "outputIndex": 5 }
          ]
        },
        "fallbackOutput": 4
      },
      "id": "route-platform",
      "name": "Route by platform",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [980, 360]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.bufferapp.com/1/updates/create.json",
        "sendBody": true,
        "specifyBody": "form",
        "bodyParameters": {
          "parameters": [
            { "name": "access_token", "value": "={{ $env.BUFFER_ACCESS_TOKEN }}" },
            { "name": "text", "value": "={{ $json.content }}" },
            { "name": "profile_ids[]", "value": "={{ $env.BUFFER_PROFILE_LINKEDIN }}" },
            { "name": "scheduled_at", "value": "={{ Math.floor(new Date($json.scheduledFor).getTime() / 1000) }}" }
          ]
        },
        "options": {}
      },
      "id": "buffer-linkedin",
      "name": "Buffer schedule → LinkedIn",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "onError": "continueErrorOutput",
      "position": [1200, 60]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.bufferapp.com/1/updates/create.json",
        "sendBody": true,
        "specifyBody": "form",
        "bodyParameters": {
          "parameters": [
            { "name": "access_token", "value": "={{ $env.BUFFER_ACCESS_TOKEN }}" },
            { "name": "text", "value": "={{ $json.content }}" },
            { "name": "profile_ids[]", "value": "={{ $env.BUFFER_PROFILE_X }}" },
            { "name": "scheduled_at", "value": "={{ Math.floor(new Date($json.scheduledFor).getTime() / 1000) }}" }
          ]
        },
        "options": {}
      },
      "id": "buffer-x-standalone",
      "name": "Buffer schedule → X (standalone)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "onError": "continueErrorOutput",
      "position": [1200, 200]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Split the thread body into individual tweets and POST a real Buffer thread.\n// Source format: \"Tweet 1/N\\n<body>\\n\\n---\\n\\nTweet 2/N\\n<body>...\"\nconst row = $input.item.json;\nconst raw = String(row.content || '');\nconst tweets = raw\n  .split(/\\n-{3,}\\n/)\n  .map((part) => part.replace(/^\\s*Tweet\\s+\\d+\\s*\\/\\s*\\d+\\s*\\n/i, '').trim())\n  .filter((t) => t.length > 0);\nif (tweets.length === 0) {\n  throw new Error(`Thread row ${row.id} (${row.fileRef}) parsed to 0 tweets`);\n}\nfor (const t of tweets) {\n  if (t.length > 280) {\n    throw new Error(`Thread row ${row.id} has a tweet over 280 chars: ${t.length}`);\n  }\n}\nconst scheduledAt = Math.floor(new Date(row.scheduledFor).getTime() / 1000);\nconst params = new URLSearchParams();\nparams.append('access_token', String(process.env.BUFFER_ACCESS_TOKEN || ''));\nparams.append('profile_ids[]', String(process.env.BUFFER_PROFILE_X || ''));\nparams.append('scheduled_at', String(scheduledAt));\nparams.append('text', tweets[0]);\nfor (let i = 1; i < tweets.length; i += 1) {\n  params.append('thread[][text]', tweets[i]);\n}\nconst resp = await fetch('https://api.bufferapp.com/1/updates/create.json', {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/x-www-form-urlencoded' },\n  body: params.toString(),\n});\nconst body = await resp.json().catch(() => ({}));\nif (!resp.ok || body.success === false) {\n  throw new Error(`Buffer thread schedule failed for ${row.fileRef}: ${resp.status} ${JSON.stringify(body).slice(0, 300)}`);\n}\nreturn { json: { tweetCount: tweets.length, bufferUpdateId: body && body.updates && body.updates[0] && body.updates[0].id, bufferResponse: body } };"
      },
      "id": "buffer-x-thread",
      "name": "Buffer schedule → X thread",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "onError": "continueErrorOutput",
      "position": [1200, 340]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ new Date($json.scheduledFor).getTime() - Date.now() }}",
              "operation": "smaller",
              "value2": 3600000
            }
          ]
        }
      },
      "id": "newsletter-due-now",
      "name": "Newsletter — due within 1h?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1200, 480]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"{{ $env.NEWSLETTER_FROM }}\",\n  \"to\": [\"{{ $env.NEWSLETTER_AUDIENCE_ID }}\"],\n  \"subject\": \"{{ $json.hookLine }}\",\n  \"text\": \"{{ $json.content }}\"\n}",
        "options": {
          "headers": {
            "parameters": {
              "Authorization": "=Bearer {{ $env.RESEND_API_KEY }}",
              "Content-Type": "application/json"
            }
          }
        }
      },
      "id": "resend-newsletter",
      "name": "Resend → Newsletter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "onError": "continueErrorOutput",
      "position": [1420, 480]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.assetUrl || '' }}", "operation": "isNotEmpty" }
          ]
        }
      },
      "id": "ig-has-asset",
      "name": "IG — has assetUrl?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1200, 640],
      "_about": "When the operator has attached an assetUrl in the admin UI, push to Buffer with provider-side scheduling. When not, fall through to the Slack 'manual publish at slot' branch."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.bufferapp.com/1/updates/create.json",
        "sendBody": true,
        "specifyBody": "form",
        "bodyParameters": {
          "parameters": [
            { "name": "access_token", "value": "={{ $env.BUFFER_ACCESS_TOKEN }}" },
            { "name": "text", "value": "={{ $json.content }}" },
            { "name": "profile_ids[]", "value": "={{ $env.BUFFER_PROFILE_INSTAGRAM }}" },
            { "name": "scheduled_at", "value": "={{ Math.floor(new Date($json.scheduledFor).getTime() / 1000) }}" },
            { "name": "media[photo]", "value": "={{ $json.assetUrl }}" }
          ]
        },
        "options": {}
      },
      "id": "buffer-instagram",
      "name": "Buffer schedule → Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "onError": "continueErrorOutput",
      "position": [1420, 640]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.assetUrl || '' }}", "operation": "isNotEmpty" }
          ]
        }
      },
      "id": "tiktok-has-asset",
      "name": "TikTok — has assetUrl?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1200, 800]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.bufferapp.com/1/updates/create.json",
        "sendBody": true,
        "specifyBody": "form",
        "bodyParameters": {
          "parameters": [
            { "name": "access_token", "value": "={{ $env.BUFFER_ACCESS_TOKEN }}" },
            { "name": "text", "value": "={{ $json.content }}" },
            { "name": "profile_ids[]", "value": "={{ $env.BUFFER_PROFILE_TIKTOK }}" },
            { "name": "scheduled_at", "value": "={{ Math.floor(new Date($json.scheduledFor).getTime() / 1000) }}" },
            { "name": "media[video]", "value": "={{ $json.assetUrl }}" }
          ]
        },
        "options": {}
      },
      "id": "buffer-tiktok",
      "name": "Buffer schedule → TikTok",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "onError": "continueErrorOutput",
      "position": [1420, 800]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ new Date($json.scheduledFor).getTime() - Date.now() }}",
              "operation": "smaller",
              "value2": 3600000
            }
          ]
        }
      },
      "id": "visual-manual-due-now",
      "name": "Visual manual — due within 1h?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1420, 960]
    },
    {
      "parameters": {
        "channel": "={{ $env.SLACK_FALLBACK_CHANNEL }}",
        "text": "=📸 Manual publish needed *now* for *{{ $('Split items').item.json.fileRef }}* ({{ $('Split items').item.json.platform }}). Slot: {{ $('Split items').item.json.scheduledFor }}.\nNo assetUrl set on this row — attach one in the admin UI to enable provider scheduling.\n\n*Hook:* {{ $('Split items').item.json.hookLine }}\n```{{ $('Split items').item.json.content }}```\nMark posted: {{ $env.SYSMOAI_ADMIN_BASE }}/scheduled-posts/{{ $('Split items').item.json.id }}",
        "otherOptions": {}
      },
      "id": "slack-visual-manual",
      "name": "Slack — visual manual publish",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1640, 960]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SYSMOAI_API_BASE }}/api/admin/scheduled-posts/{{ $('Split items').item.json.id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"postUrl\": \"manual://{{ $('Split items').item.json.platform }}/{{ $('Split items').item.json.id }}\",\n  \"notes\": \"Manual publish requested in Slack at {{ $now.toISO() }} (no assetUrl).\"\n}",
        "options": {
          "headers": {
            "parameters": {
              "Authorization": "=Bearer {{ $env.SYSMOAI_AUTOMATION_TOKEN }}",
              "Content-Type": "application/json"
            }
          }
        }
      },
      "id": "mark-manual-pending",
      "name": "Mark manual-pending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1860, 960]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SYSMOAI_API_BASE }}/api/admin/scheduled-posts/{{ $('Split items').item.json.id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"postUrl\": \"buffer://{{ ($json.body && $json.body.updates && $json.body.updates[0] && $json.body.updates[0].id) || $json.bufferUpdateId || $json.id || 'unknown' }}\",\n  \"notes\": \"Queued in Buffer for {{ $('Split items').item.json.scheduledFor }}.\"\n}",
        "options": {
          "headers": {
            "parameters": {
              "Authorization": "=Bearer {{ $env.SYSMOAI_AUTOMATION_TOKEN }}",
              "Content-Type": "application/json"
            }
          }
        }
      },
      "id": "mark-buffer-queued",
      "name": "Mark Buffer-queued",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1640, 200],
      "_about": "Stamps postUrl with the Buffer update id (using the original row id from Split items, NOT $json.id which is now Buffer's response). Single sink for LinkedIn / X-standalone / X-thread / Instagram / TikTok success branches."
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SYSMOAI_API_BASE }}/api/admin/scheduled-posts/{{ $('Split items').item.json.id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"status\": \"posted\",\n  \"postUrl\": \"resend://{{ ($json.id || 'sent') }}\",\n  \"notes\": \"Sent via Resend at {{ $now.toISO() }}.\"\n}",
        "options": {
          "headers": {
            "parameters": {
              "Authorization": "=Bearer {{ $env.SYSMOAI_AUTOMATION_TOKEN }}",
              "Content-Type": "application/json"
            }
          }
        }
      },
      "id": "mark-newsletter-posted",
      "name": "Mark newsletter posted",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1640, 480]
    },
    {
      "parameters": {
        "channel": "={{ $env.SLACK_FALLBACK_CHANNEL }}",
        "text": "=⚠️ Auto-publish FAILED for *{{ $('Split items').item.json.fileRef }}* ({{ $('Split items').item.json.platform }}). Please publish manually:\n*Hook:* {{ $('Split items').item.json.hookLine }}\n```{{ $('Split items').item.json.content }}```\nMark posted: {{ $env.SYSMOAI_ADMIN_BASE }}/scheduled-posts/{{ $('Split items').item.json.id }}",
        "otherOptions": {}
      },
      "id": "slack-error-fallback",
      "name": "Slack — provider failure",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1860, 60]
    }
  ],
