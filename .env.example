# SYSmoAI Website - Environment Configuration

# General
NODE_ENV=development
SITE_URL=https://sysmoai.com
SITE_TITLE=SYSmoAI - AI Automation & No-Code Systems for Bangladesh

# Build Configuration
BUILD_FRAMEWORK=next.js
BUILD_LANGUAGE=typescript

# Database (if needed)
DATABASE_URL=postgresql://user:password@localhost:5432/sysmoai_website

# API Configuration
API_BASE_URL=https://api.sysmoai.com
API_KEY=your_api_key_here

# Authentication
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_password
CONTACT_EMAIL=contact@sysmoai.com

# Third-party Services
GOOGLE_ANALYTICS_ID=
SENTRY_DSN=

# WhatsApp Integration
WHATSAPP_PHONE=+880XXXXXXXXX
WHATSAPP_BUSINESS_API_URL=https://api.whatsapp.com

# Media & Assets
IMAGE_OPTIMIZATION_ENABLED=true
CDN_URL=https://cdn.sysmoai.com

# Feature Flags
FEATURES_CONTACT_FORM=true
FEATURES_NEWSLETTER=true
FEATURES_BLOG=true
